# Editor configuration for Bash WP-CLI Update.
#
# The scripts run on Linux and are executed by bash 4.2+. Two settings here are not
# cosmetic: `end_of_line = lf` (a CR byte becomes part of the last word on every line
# and breaks `case` labels, pattern matching and the generated site list) and
# `insert_final_newline = true` (a file without it makes `while read` skip its last
# line, which on a site list means silently skipping a site).

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{sh,wp}]
indent_size = 4
# Shell scripts are not tabs-vs-spaces taste: 4 spaces keep the heredocs and the
# `case` bodies aligned with the rest of the tree.

[*.md]
trim_trailing_whitespace = false
# Two trailing spaces are a hard line break in Markdown; stripping them silently
# changes the rendered document.

[*.{yml,yaml}]
indent_size = 2

[Makefile]
indent_style = tab
# A Makefile recipe line that starts with spaces is not a recipe line.

[*.{example,conf}]
indent_size = 4
